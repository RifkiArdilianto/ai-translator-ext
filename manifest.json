{
  "manifest_version": 3,
  "name": "AI Translator Extc",
  "version": "1.0",
  "description": "Ekstensi penerjemah dan pembuat ringkasan kursus otomatis berbasis AI.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}